# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored. Production values live in Google Secret Manager, never in files.

HAGGLE_ENV=local
HAGGLE_DATABASE_URL=postgresql+psycopg://haggle:haggle@localhost:5432/haggle

# Tests read this from the shell environment (not from .env). The default already matches
# the docker compose database, so you normally don't need to set it.
# HAGGLE_TEST_DATABASE_URL=postgresql+psycopg://haggle:haggle@localhost:5432/haggle_test
