# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored. Production values live in Google Secret Manager, never in files.

HAGGLE_ENV=local
HAGGLE_DATABASE_URL=postgresql+psycopg://haggle:haggle@localhost:5432/haggle

# Tests read this from the shell environment (not from .env). The default already matches
# the docker compose database, so you normally don't need to set it.
# HAGGLE_TEST_DATABASE_URL=postgresql+psycopg://haggle:haggle@localhost:5432/haggle_test

# MCP server (uv run haggle-mcp). Any random strings locally; Secret Manager in the cloud.
HAGGLE_MCP_SELLER_TOKEN=change-me-seller
HAGGLE_MCP_CATALOG_TOKEN=change-me-catalog

# Gemini backend (ADR-0013). The google-genai SDK (ADK, LangChain, embeddings) reads these.
# Default: Vertex AI with your gcloud login, no API key:
#   gcloud auth application-default login
#   gcloud services enable aiplatform.googleapis.com
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global   # gemini-3.1-flash-lite and gemini-embedding-2 are both on "global"
# Alternative: Gemini API (AI Studio). Set GOOGLE_GENAI_USE_VERTEXAI=false and:
# GOOGLE_API_KEY=

# Langfuse Cloud (EU), week 3: Project settings -> API keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
